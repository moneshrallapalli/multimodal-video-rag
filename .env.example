# Copy to .env and fill in. Never commit the real .env.

# ── AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Bedrock (model IDs confirmed working 2026-06, us-east-1) ──
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TEXT_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_IMAGE_EMBED_MODEL_ID=amazon.titan-embed-image-v1
EMBED_DIM=1024

# ── Pinecone ──────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_TRANSCRIPT_INDEX=transcript
PINECONE_VISUAL_INDEX=visual

# ── LangSmith ─────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multimodal-video-rag

# ── AWS resources (filled in as infra is created) ─────
S3_BUCKET=
SQS_QUEUE_URL=
DYNAMODB_VIDEOS_TABLE=videos
DYNAMODB_JOBS_TABLE=jobs
DYNAMODB_QUERY_CACHE_TABLE=query_cache
DYNAMODB_RATE_LIMIT_TABLE=rate_limits

# Optional runtime secret name. In deployed API/worker this can point to a
# Secrets Manager JSON secret with PINECONE_API_KEY, LANGSMITH_API_KEY,
# ADMIN_PASSWORD_HASH, and SESSION_SECRET.
SECRETS_MANAGER_SECRET_NAME=

# ── Ingestion worker ──────────────────────────────────
INGEST_FRAME_INTERVAL_SECONDS=30
INGEST_MAX_FRAMES=20
WHISPER_MODEL_SIZE=tiny.en
TRANSCRIPT_CHUNK_SECONDS=30
TRANSCRIPT_CHUNK_OVERLAP_SECONDS=6

# ── Query pipeline feature flags ──────────────────────
ENABLE_HYBRID_TRANSCRIPT=true
ENABLE_CROSS_ENCODER_RERANK=false
ENABLE_QUERY_REWRITE=true
HYBRID_ALPHA=0.7
SEARCH_CONFIG_VERSION=hybrid-rewrite-v1

# ── Admin auth (store the argon2 hash, never the plaintext) ──
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ── Public query cost controls ─────────────────────────
QUERY_CACHE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
