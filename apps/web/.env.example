# Web app environment. Copy to .env.local for local overrides (.env.local is gitignored).

# Backend base URL used by the browser API client (src/lib/api.ts).
# Leave EMPTY in dev: the browser calls the API same-origin and Next proxies it
# (next.config.ts rewrites) to API_PROXY_TARGET. In production set this to the deployed
# API (e.g. the API Gateway URL) so the browser calls it directly (CORS is enabled there).
NEXT_PUBLIC_API_BASE_URL=

# Where the dev rewrite proxies /api and /health (server-side, dev only).
API_PROXY_TARGET=http://127.0.0.1:8000
